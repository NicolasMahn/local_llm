+def position_ids_in_meshgrid(patch_embeds_list, max_width):
+    """(row, column) of every patch, which Transformers 5 rotates by.
+
+    Transformers 4 took flat row * max_width + column indices instead. The
+    angles are the same, so max_width is no longer needed.
+    """
+    positions = []
+    for patch in patch_embeds_list:
+        rows, columns = torch.meshgrid(
+            torch.arange(patch.shape[-2], device=patch.device),
+            torch.arange(patch.shape[-1], device=patch.device),
+            indexing="ij",
+        )
+        positions.append(torch.stack([rows.flatten(), columns.flatten()], dim=-1))
+    return torch.cat(positions, dim=0)
+
